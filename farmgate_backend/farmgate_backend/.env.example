# Django — generate a new key for each environment; rotate if compromised:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Comma-separated lists (no spaces around commas)
ALLOWED_HOSTS=*,localhost,127.0.0.1,farmgate-backend.onrender.com,farm-gate-mango.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://farm-gate-mango-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://farm-gate-mango.onrender.com,https://farm-gate-mango-frontend.onrender.com
MEDIA_BASE_URL=https://farmgate-backend.onrender.com

# Google OAuth — must match frontend VITE_GOOGLE_CLIENT_ID (public OAuth client id)
GOOGLE_OAUTH_CLIENT_ID=

# Rate limits (DRF throttle rates: e.g. 100/hour, 10/minute)
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_AUTH=10/minute

# --- PostgreSQL (used by default for both local development and production) ---
# Set USE_SQLITE=True only if you explicitly want SQLite for local testing.
USE_SQLITE=False

# Option A: single URL (Render, Railway, Neon, Supabase all provide this)
# DATABASE_URL=postgres://farmgate:farmgate@localhost:5432/farmgate

# Option B: individual variables (works with docker compose up -d)
DB_HOST=localhost
DB_NAME=farmgate
DB_USER=farmgate
DB_PASSWORD=farmgate
DB_PORT=5432

# Reuse DB connections across requests (seconds). 600 = 10 minutes.
DB_CONN_MAX_AGE=600

# --- Redis (optional locally; recommended in production for rate limits across workers) ---
# REDIS_URL=redis://localhost:6379/0

# --- Gunicorn (production) ---
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=2
